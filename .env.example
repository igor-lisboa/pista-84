# Balance applied when the game loads and when progress is imported or restored.
# Empty = use the saved balance. Zero is also a valid override.
PISTA84_COINS=
# Local only. Heroku supplies PORT automatically; do not set it in config vars.
PORT=4173
# Durable scores, account credentials/sessions and progress backups. Never exposed to the browser.
MONGODB_URI="mongodb+srv://user:pass@host/?retryWrites=true&w=majority"
# Explicit database name; defaults to pista84, independently of the URI path.
MONGODB_DATABASE=pista84
# Shared pairing (10 min), socket presence (15 sec), input (2 sec) and Pub/Sub.
REDIS_URL="redis://default:password@host:port"
# Optional edge Worker: HTTPS origin of a Node/Vercel deployment running these APIs.
API_ORIGIN=
# External origin for reverse proxies and HTTPS phone sensors. On Heroku:
# PUBLIC_ORIGIN=https://pista-84-e7d109005460.herokuapp.com
# Without it, Heroku requests use the router's X-Forwarded-Proto header.
# Account deployments must use HTTPS for credentials and Secure session cookies.
PUBLIC_ORIGIN=
