# Balance applied when the game loads and when progress is imported or restored.
# Empty = use the saved balance. Zero is also a valid override.
PISTA84_COINS=
PORT=4173
# Online storage (leaderboard + cloud backup) lives in a private Vercel Blob store.
# Vercel injects these when the store is connected with the BLOB_STORAGE prefix;
# for local use put them in .env.local (or run: vercel env pull .env.local).
# Verify the connection with: npm run online:check
BLOB_STORAGE_READ_WRITE_TOKEN=
BLOB_STORAGE_STORE_ID=
