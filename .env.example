# Balance applied when the game loads and when progress is imported or restored.
# Empty = use the saved balance. Zero is also a valid override.
PISTA84_COINS=
PORT=4173
# Durable scores and manual progress backups. Never exposed to the browser.
MONGODB_URI="mongodb+srv://user:pass@host/?retryWrites=true&w=majority"
# Explicit database name; defaults to pista84, independently of the URI path.
MONGODB_DATABASE=pista84
# Shared ephemeral pairing (10 min) and latest controller input (2 sec).
REDIS_URL="redis://default:password@host:port"
# Optional edge Worker: HTTPS origin of a Node/Vercel deployment running these APIs.
API_ORIGIN=
# Optional local reverse proxy URL, also needed for phone sensors over HTTPS.
PUBLIC_ORIGIN=
