# Balance applied when the game loads and when progress is imported or restored.
# Empty = use the saved balance. Zero is also a valid override.
PISTA84_COINS=
PORT=4173
# Online storage (leaderboard + cloud backup) lives in one Vercel Global Config item.
# GLOBAL_CONFIG is injected by Vercel; run `vercel env pull` for local use.
GLOBAL_CONFIG=
# Token with write access to the Global Config (Vercel > Account > Tokens).
VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=
# Refuse writes above this size in bytes (hobby ~8000, pro ~64000).
# GLOBAL_CONFIG_MAX_BYTES=8000
# PUBLIC_ORIGIN=https://your-domain.example
